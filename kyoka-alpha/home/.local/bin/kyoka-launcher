#!/usr/bin/env bash
# Kyoka launcher: a floating foot window running fzf over desktop entries.
# Hyprland gives it the shard frame and aura (see hypr/kyoka-*.lua); foot
# requests the blur through ext-background-effect.
# Pressing the bind again while it is open closes it.
set -euo pipefail

if hyprctl clients -j | grep -q '"class": "kyoka-launcher"'; then
    hyprctl eval 'kyoka_close_launcher()' >/dev/null
    exit 0
fi

exec foot \
    --app-id=kyoka-launcher \
    --title=Launcher \
    -o main.pad=18x14 \
    -o main.font="Martian Mono:size=10" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.86 \
    -o colors-dark.blur=yes \
    "$HOME/.local/bin/kyoka-launcher-menu"
